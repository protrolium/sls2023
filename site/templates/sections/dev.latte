<main class="page-content dev-embed uk-padding-remove uk-margin-remove-bottom" aria-label="Development preview">
	<style>
		.dev-embed {
			padding-left: 0 !important;
			padding-right: 0 !important;
		}
		.dev-embed__shell {
			width: 100%;
			height: 100dvh;
			min-height: 320px;
		}
		.dev-embed__frame {
			width: 100%;
			height: 100%;
			border: 0;
			display: block;
		}
	</style>
	<div class="dev-embed__shell">
		<iframe
			class="dev-embed__frame"
			src="https://strangeloop-studios.pages.dev/"
			title="Strangeloop Studios"
			loading="lazy"
			referrerpolicy="no-referrer-when-downgrade"
			allowfullscreen
		></iframe>
	</div>
</main>
